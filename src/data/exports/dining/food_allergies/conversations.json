                "italian": "/audio/33_sev_m3_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_sev_m3_h.opus"
          }
        },
        {
          "id": "m4",
          "role": "host",
          "text": "Dobbiamo stare molto attenti.",
          "english": "We must be very careful.",
          "choices": [
            {
              "text": "Niente tracce di uova, vero?",
