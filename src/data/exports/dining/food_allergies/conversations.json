{
  "scenarioId": 33,
  "conversations": [
    {
      "id": "nut_allergy",
      "title": "Nut Allergy",
      "description": "Checking if a dish contains nuts.",
      "messages": [
        {
          "id": "m1",
          "role": "host",
          "text": "Buonasera. Siete pronti per ordinare?",
          "english": "Good evening. Are you ready to order?",
          "choices": [
            {
              "text": "Sì, ma sono allergico alle noci.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m1_c1.opus"
              }
            },
            {
              "text": "No, vorrei un tavolo fuori ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m1_c2.opus"
              }
            },
            {
              "text": "Sì, vorrei un caffè molto caldo.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m1_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m1_h.opus"
          }
        },
        {
          "id": "m2",
          "role": "host",
          "text": "Ah, mi dispiace. Quale piatto volete?",
          "english": "Ah, I'm sorry. Which dish do you want?",
          "choices": [
            {
              "text": "La pasta al pesto ha le noci?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m2_c1.opus"
              }
            },
            {
              "text": "Il menù del giorno è buono qui?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m2_c2.opus"
              }
            },
            {
              "text": "La sedia al tavolo è comoda ora?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m2_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m2_h.opus"
          }
        },
        {
          "id": "m3",
          "role": "host",
          "text": "Sì, il nostro pesto contiene noci.",
          "english": "Yes, our pesto contains nuts.",
          "choices": [
            {
              "text": "Allora non posso mangiarlo ora.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m3_c1.opus"
              }
            },
            {
              "text": "Allora vorrei bere un po' d'acqua.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m3_c2.opus"
              }
            },
            {
              "text": "Quante sedie ci sono al tavolo?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m3_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m3_h.opus"
          }
        },
        {
          "id": "m4",
          "role": "host",
          "text": "Certo. Volete la pasta al pomodoro?",
          "english": "Sure. Do you want the pasta with tomato sauce?",
          "choices": [
            {
              "text": "Sì, la pasta al pomodoro è sicura?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m4_c1.opus"
              }
            },
            {
              "text": "No, il pomodoro è molto rosso oggi.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m4_c2.opus"
              }
            },
            {
              "text": "Sì, il tavolo è vicino alla porta?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m4_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m4_h.opus"
          }
        },
        {
          "id": "m5",
          "role": "host",
          "text": "Sì, è solo pomodoro, olio e sale.",
          "english": "Yes, it's just tomato, oil and salt.",
          "choices": [
            {
              "text": "Ottimo. Senza tracce di noci, vero?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m5_c1.opus"
              }
            },
            {
              "text": "Bene. Avete del pane fresco qui?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m5_c2.opus"
              }
            },
            {
              "text": "Chiaro. Dov'è il bagno del locale?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m5_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m5_h.opus"
          }
        },
        {
          "id": "m6",
          "role": "host",
          "text": "Sì, usiamo una pentola pulita ora.",
          "english": "Yes, we are using a clean pot now.",
          "choices": [
            {
              "text": "Grazie. Avvisate lo chef, per favore.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m6_c1.opus"
              }
            },
            {
              "text": "Bene. Posso avere un cucchiaio ora?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m6_c2.opus"
              }
            },
            {
              "text": "Prego. Dov'è la cucina del locale?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m6_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m6_h.opus"
          }
        },
        {
          "id": "m7",
          "role": "host",
          "text": "Lo informo subito. Altro?",
          "english": "I'll inform him immediately. Anything else?",
          "choices": [
            {
              "text": "Vorrei anche un'insalata semplice.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m7_c1.opus"
              }
            },
            {
              "text": "Vorrei vedere il conto subito ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m7_c2.opus"
              }
            },
            {
              "text": "Vorrei uscire a fare una passeggiata.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m7_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m7_h.opus"
          }
        },
        {
          "id": "m8",
          "role": "host",
          "text": "L'insalata ha solo verdure fresche.",
          "english": "The salad only has fresh vegetables.",
          "choices": [
            {
              "text": "Sì, l'insalata senza noci va bene.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m8_c1.opus"
              }
            },
            {
              "text": "No, l'insalata è troppo verde ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m8_c2.opus"
              }
            },
            {
              "text": "Sì, il tavolo è pulito per mangiare.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m8_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m8_h.opus"
          }
        },
        {
          "id": "m9",
          "role": "host",
          "text": "Perfetto. Porto tutto tra poco.",
          "english": "Perfect. I'll bring everything soon.",
          "choices": [
            {
              "text": "Va bene, aspetto qui al tavolo.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_nut_m9_c1.opus"
              }
            },
            {
              "text": "Ok, vado a casa a dormire ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m9_c2.opus"
              }
            },
            {
              "text": "Sì, il cameriere è molto veloce.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m9_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m9_h.opus"
          }
        },
        {
          "id": "m10",
          "role": "host",
          "text": "Ecco il vostro ordine. Buon appetito!",
          "english": "Here is your order. Enjoy your meal!",
          "choices": [
            {
              "text": "Grazie. Spero sia tutto sicuro!",
              "isCorrect": true,
              "nextMessageId": "END",
              "audio": {
                "italian": "/audio/33_nut_m10_c1.opus"
              }
            },
            {
              "text": "Prego. Posso avere un altro menù?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m10_c2.opus"
              }
            },
            {
              "text": "Dov'è il sale per l'insalata ora?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_nut_m10_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_nut_m10_h.opus"
          }
        }
      ]
    },
    {
      "id": "gluten_free",
      "title": "Gluten Free",
      "description": "Ordering a gluten-free meal.",
      "messages": [
        {
          "id": "m1",
          "role": "host",
          "text": "Benvenuti! Avete bisogno di aiuto?",
          "english": "Welcome! Do you need help?",
          "choices": [
            {
              "text": "Sì, vorrei un piatto senza glutine.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m1_c1.opus"
              }
            },
            {
              "text": "No, vorrei un tavolo vicino al bar.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m1_c2.opus"
              }
            },
            {
              "text": "Sì, il menù è molto grande oggi.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m1_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m1_h.opus"
          }
        },
        {
          "id": "m2",
          "role": "host",
          "text": "Certamente. Siete celiaco?",
          "english": "Certainly. Are you celiac?",
          "choices": [
            {
              "text": "Sì, il glutine mi fa male.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m2_c1.opus"
              }
            },
            {
              "text": "No, il pane è molto caldo qui.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m2_c2.opus"
              }
            },
            {
              "text": "Sì, il cameriere è gentile oggi.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m2_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m2_h.opus"
          }
        },
        {
          "id": "m3",
          "role": "host",
          "text": "Abbiamo pasta e pane senza glutine.",
          "english": "We have gluten-free pasta and bread.",
          "choices": [
            {
              "text": "Ottimo. Vorrei la pasta al sugo.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m3_c1.opus"
              }
            },
            {
              "text": "Bene. Vorrei una birra molto fredda.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m3_c2.opus"
              }
            },
            {
              "text": "Prego. Dov'è la finestra del locale?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m3_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m3_h.opus"
          }
        },
        {
          "id": "m4",
          "role": "host",
          "text": "Va bene. Volete anche il pane?",
          "english": "All right. Do you also want bread?",
          "choices": [
            {
              "text": "Sì, se è pane senza glutine.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m4_c1.opus"
              }
            },
            {
              "text": "No, il pane ha molta farina nera.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m4_c2.opus"
              }
            },
            {
              "text": "Sì, il pane è sul tavolo rosso.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m4_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m4_h.opus"
          }
        },
        {
          "id": "m5",
          "role": "host",
          "text": "Certo, è pane speciale per voi.",
          "english": "Of course, it's special bread for you.",
          "choices": [
            {
              "text": "Grazie. Siete molto attenti qui.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m5_c1.opus"
              }
            },
            {
              "text": "Prego. Il tavolo è troppo piccolo.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m5_c2.opus"
              }
            },
            {
              "text": "Chiaro. Voglio un bicchiere di vino.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m5_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m5_h.opus"
          }
        },
        {
          "id": "m6",
          "role": "host",
          "text": "La sicurezza è importante per noi.",
          "english": "Safety is important to us.",
          "choices": [
            {
              "text": "Lo chef usa attrezzi puliti?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m6_c1.opus"
              }
            },
            {
              "text": "Il cameriere ha una divisa blu?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m6_c2.opus"
              }
            },
            {
              "text": "La cucina è aperta stasera ora?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m6_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m6_h.opus"
          }
        },
        {
          "id": "m7",
          "role": "host",
          "text": "Sì, la nostra cucina è certificata.",
          "english": "Yes, our kitchen is certified.",
          "choices": [
            {
              "text": "Perfetto. Mi sento più sicuro ora.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m7_c1.opus"
              }
            },
            {
              "text": "Chiaro. La sedia è troppo dura ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m7_c2.opus"
              }
            },
            {
              "text": "Bene. Voglio un dolce con crema.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m7_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m7_h.opus"
          }
        },
        {
          "id": "m8",
          "role": "host",
          "text": "Volete ordinare anche il dolce?",
          "english": "Do you want to order dessert too?",
          "choices": [
            {
              "text": "Avete un dolce senza glutine?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m8_c1.opus"
              }
            },
            {
              "text": "Avete un dolce molto grande qui?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m8_c2.opus"
              }
            },
            {
              "text": "Avete un dolce con molta farina?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m8_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m8_h.opus"
          }
        },
        {
          "id": "m9",
          "role": "host",
          "text": "Sì, abbiamo una torta di riso.",
          "english": "Yes, we have a rice cake.",
          "choices": [
            {
              "text": "Prendo la torta di riso, grazie.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_glut_m9_c1.opus"
              }
            },
            {
              "text": "Prendo un biscotto di grano ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m9_c2.opus"
              }
            },
            {
              "text": "Prendo un pezzo di pane bianco.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m9_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m9_h.opus"
          }
        },
        {
          "id": "m10",
          "role": "host",
          "text": "Arriva tutto subito. Buon pranzo!",
          "english": "Everything is coming right away. Enjoy your lunch!",
          "choices": [
            {
              "text": "Grazie mille per l'aiuto oggi.",
              "isCorrect": true,
              "nextMessageId": "END",
              "audio": {
                "italian": "/audio/33_glut_m10_c1.opus"
              }
            },
            {
              "text": "Prego, voglio pagare il conto ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m10_c2.opus"
              }
            },
            {
              "text": "Sì, la porta è aperta per uscire.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_glut_m10_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_glut_m10_h.opus"
          }
        }
      ]
    },
    {
      "id": "dairy_free",
      "title": "Dairy Free",
      "description": "Avoiding milk and dairy products.",
      "messages": [
        {
          "id": "m1",
          "role": "host",
          "text": "Buongiorno. Cosa posso portarvi?",
          "english": "Good morning. What can I bring you?",
          "choices": [
            {
              "text": "C'è del latte in questo piatto?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_dair_m1_c1.opus"
              }
            },
            {
              "text": "C'è del sale in questo piatto?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m1_c2.opus"
              }
            },
            {
              "text": "C'è del sole in questo piatto?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m1_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_dair_m1_h.opus"
          }
        },
        {
          "id": "m2",
          "role": "host",
          "text": "Quale piatto? La pizza margherita?",
          "english": "Which dish? The margherita pizza?",
          "choices": [
            {
              "text": "Sì, sono allergico ai latticini.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_dair_m2_c1.opus"
              }
            },
            {
              "text": "No, sono allergico ai gatti neri.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m2_c2.opus"
              }
            },
            {
              "text": "Sì, sono stanco di camminare ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m2_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_dair_m2_h.opus"
          }
        },
        {
          "id": "m3",
          "role": "host",
          "text": "Sì, la margherita ha la mozzarella.",
          "english": "Yes, the margherita has mozzarella.",
          "choices": [
            {
              "text": "Potete farla senza formaggio?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_dair_m3_c1.opus"
              }
            },
            {
              "text": "Potete farla senza il lievito?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m3_c2.opus"
              }
            },
            {
              "text": "Potete farla senza la farina?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m3_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_dair_m3_h.opus"
          }
        },
        {
          "id": "m4",
          "role": "host",
          "text": "Certamente. Volete altre verdure?",
          "english": "Certainly. Do you want other vegetables?",
          "choices": [
            {
              "text": "Sì, vorrei zucchine e peperoni.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_dair_m4_c1.opus"
              }
            },
            {
              "text": "No, vorrei fragole e banane ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m4_c2.opus"
              }
            },
            {
              "text": "Sì, vorrei carne e uova sode ora.",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m4_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_dair_m4_h.opus"
          }
        },
        {
          "id": "m5",
          "role": "host",
          "text": "Va bene. E l'impasto è sicuro.",
          "english": "All right. And the dough is safe.",
          "choices": [
            {
              "text": "L'impasto non contiene latte?",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_dair_m5_c1.opus"
              }
            },
            {
              "text": "L'impasto non contiene acqua?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m5_c2.opus"
              }
            },
            {
              "text": "L'impasto non contiene sale?",
              "isCorrect": false,
              "audio": {
                "italian": "/audio/33_dair_m5_c3.opus"
              }
            }
          ],
          "audio": {
            "italian": "/audio/33_dair_m5_h.opus"
          }
        },
        {
          "id": "m6",
          "role": "host",
