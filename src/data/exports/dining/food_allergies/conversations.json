          "role": "host",
          "text": "Sì, il pollo è senza allergeni.",
          "english": "Yes, the chicken is allergen-free.",
          "choices": [
            {
              "text": "Perfetto. Solo olio e sale.",
              "isCorrect": true,
              "audio": {
                "italian": "/audio/33_sev_m9_c1.opus"
