            {
              "text": "Sì, una bustina, per favore.",
              "isCorrect": true,
              "feedback": "Benissimo."
            },
            {
              "text": "No, non mangio mai niente.",
              "isCorrect": false,
              "feedback": "Sugar is for the coffee, not eating."
            },
            {
              "text": "Voglio un pezzo di torta.",
              "isCorrect": false,
              "feedback": "Answer the question about sugar first."
            }
          ]
        },
        {
          "id": "m4",
          "role": "host",
          "text": "Lo zucchero è lì sul banco.",
          "english": "The sugar is there on the counter.",
          "choices": [
            {
              "text": "Ah, lo vedo, grazie mille!",
              "isCorrect": true,
              "feedback": "Great response."
            },
            {
              "text": "Non c'è il mio tavolo qui.",
              "isCorrect": false,
              "feedback": "You are at the counter."
            },
            {
              "text": "Vado via senza pagare ora.",
              "isCorrect": false,
              "feedback": "You must pay!"
            }
          ]
        },
        {
          "id": "m5",
          "role": "host",
          "text": "Vuoi anche un bicchiere d'acqua?",
          "english": "Do you also want a glass of water?",
          "choices": [
            {
              "text": "Sì, grazie, acqua naturale.",
              "isCorrect": true,
              "feedback": "Perfect."
            },
            {
              "text": "No, voglio un vino rosso.",
              "isCorrect": false,
              "feedback": "It's morning!"
            },
            {
              "text": "Non ho sete, voglio bere.",
              "isCorrect": false,
              "feedback": "Contradictory."
            }
          ]
        },
        {
          "id": "m6",
          "role": "host",
          "text": "Ecco l'acqua. Mangi qualcosa?",
          "english": "Here is the water. Are you eating anything?",
          "choices": [
            {
              "text": "No, oggi solo un caffè, grazie.",
              "isCorrect": true,
              "feedback": "Good."
            },
            {
              "text": "Voglio mangiare una bistecca.",
              "isCorrect": false,
              "feedback": "Not at a breakfast bar."
            },
            {
              "text": "Sì, ma non so cosa voglio.",
              "isCorrect": false,
              "feedback": "Usually you decide quickly at the bar."
            }
          ]
        },
        {
          "id": "m7",
          "role": "host",
          "text": "Va bene. Sei di fretta oggi?",
          "english": "Alright. Are you in a hurry today?",
          "choices": [
            {
              "text": "Sì, devo andare al lavoro.",
              "isCorrect": true,
              "feedback": "Very natural."
            },
            {
              "text": "No, vivo qui per sempre.",
              "isCorrect": false,
              "feedback": "A bit strange."
            },
            {
              "text": "Non parlo mai di lavoro.",
              "isCorrect": false,
              "feedback": "Too blunt."
            }
          ]
        },
        {
          "id": "m8",
          "role": "host",
          "text": "Allora fai presto! Quant'è?",
          "english": "Then be quick! How much is it?",
          "choices": [
            {
              "text": "Quanto costa in totale?",
              "isCorrect": true,
              "feedback": "Correct way to ask."
            },
            {
              "text": "Non voglio pagare niente.",
              "isCorrect": false,
              "feedback": "You have to pay."
            },
            {
              "text": "È troppo caro per me oggi.",
              "isCorrect": false,
              "feedback": "You don't know the price yet!"
            }
          ]
        },
        {
          "id": "m9",
          "role": "host",
          "text": "Sono un euro e venti.",
          "english": "It's one euro and twenty.",
          "choices": [
            {
              "text": "Ecco due euro, tieni il resto.",
              "isCorrect": true,
              "feedback": "Generous and correct."
            },
            {
              "text": "Non ho soldi, mi dispiace.",
              "isCorrect": false,
              "feedback": "You must pay!"
            },
            {
              "text": "Ti do cento euro in contanti.",
              "isCorrect": false,
              "feedback": "Too big of a bill for a coffee."
            }
          ]
        },
        {
          "id": "m10",
          "role": "host",
          "text": "Grazie, buona giornata e buon lavoro!",
          "english": "Thank you, have a good day and good work!",
          "choices": [
            {
              "text": "Grazie a te, buona giornata!",
              "isCorrect": true,
              "feedback": "Perfect closing."
            },
            {
              "text": "Non voglio lavorare oggi.",
              "isCorrect": false,
              "feedback": "Not a standard polite response."
            },
            {
              "text": "Dove posso andare a dormire?",
              "isCorrect": false,
              "feedback": "Irrelevant now."
            }
          ]
        }
      ]
    },
    {
