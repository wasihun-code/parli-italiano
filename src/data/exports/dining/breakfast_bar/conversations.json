            {
              "text": "Buongiorno. Un caffè, per favore.",
              "isCorrect": true,
              "feedback": "Perfetto!"
            },
            {
              "text": "Voglio un tavolo grande ora.",
              "isCorrect": false,
              "feedback": "Too aggressive and not right for a quick espresso."
            },
            {
              "text": "Dov'è il bagno degli uomini?",
              "isCorrect": false,
              "feedback": "Start with ordering!"
            }
          ]
        },
        {
          "id": "m2",
          "role": "host",
          "text": "Certamente. Normale o macchiato?",
          "english": "Certainly. Normal or with a spot of milk?",
          "choices": [
            {
              "text": "Normale, grazie. Molto gentile.",
              "isCorrect": true,
              "feedback": "Ottimo."
            },
            {
              "text": "Voglio un piatto di pasta.",
              "isCorrect": false,
              "feedback": "You don't order pasta at a breakfast bar."
            },
            {
              "text": "Non mi piace il caffè oggi.",
              "isCorrect": false,
              "feedback": "Then why did you order it?"
            }
          ]
        },
        {
          "id": "m3",
          "role": "host",
          "text": "Ecco il tuo caffè. Zucchero?",
          "english": "Here is your coffee. Sugar?",
