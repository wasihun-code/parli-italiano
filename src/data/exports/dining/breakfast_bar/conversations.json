{
  "scenarioId": 38,
  "conversations": [
    {
      "id": "quick_espresso",
      "title": "Quick Espresso",
      "description": "Order a quick espresso at the counter.",
      "messages": [
        {
          "id": "m1",
          "role": "host",
          "text": "Buongiorno! Prego, dimmi pure.",
          "english": "Good morning! Please, tell me.",
